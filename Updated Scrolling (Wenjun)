#include <Wire.h>
#include "rgb_lcd.h"
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

rgb_lcd lcd;

Adafruit_SSD1306 oled(128, 64, &Wire, -1);

struct ExerciseRecord {
  const char* name;
  const char* exercise;
  int score;
};

const int recordCount = 3;

ExerciseRecord records[recordCount] = {
  {"Alex", "Squat", 86},
  {"Jamie", "Lunge", 92},
  {"Taylor", "Push-up", 78}
};

int selectedRecord = 0;
bool scrolling = false;

unsigned long lastScrollTime = 0;
const unsigned long scrollInterval = 600;

// Draw the name list on the small screen.
void showNames() {
  oled.clearDisplay();
  oled.setTextSize(1);
  oled.setTextColor(SSD1306_WHITE);
  oled.setCursor(0, 0);

  if (scrolling) {
    oled.print("CCCare - Scrolling");
  } else {
    oled.print("CCCare - Chosen");
  }

  // Keep the selected name within a three-name window.
  int firstRecord = selectedRecord - 1;

  if (firstRecord < 0) {
    firstRecord = 0;
  }

  for (int row = 0; row < 3; row++) {
    int index = firstRecord + row;

    if (index < recordCount) {
      oled.setCursor(0, 18 + row * 14);

      if (index == selectedRecord) {
        oled.print("> ");
      } else {
        oled.print("  ");
      }

      oled.print(records[index].name);
    }
  }

  oled.display();
}

// Draw the selection or score on the large screen.
void showScore() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(records[selectedRecord].name);

  lcd.setCursor(0, 1);

  if (scrolling) {
    lcd.print("Selecting...");
  } else {
    lcd.print(records[selectedRecord].exercise);
    lcd.print(" ");
    lcd.print(records[selectedRecord].score);
    lcd.print("/100");
  }
}

void setup() {
  Wire.begin();

  lcd.begin(16, 2);
  lcd.setRGB(255, 255, 255);

  oled.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  oled.setTextWrap(false);

  showNames();
  showScore();
}

void loop() {
  int knob = analogRead(A2);
  unsigned long now = millis();

  bool updateScreens = false;

  // Turn left to start scrolling.
  if (!scrolling && knob < 460) {
    scrolling = true;
    lastScrollTime = now;
    updateScreens = true;
  }

  // Return to the middle or turn right to choose.
  if (scrolling && knob >= 500) {
    scrolling = false;
    updateScreens = true;
  }

  // Advance through the records while the knob stays left.
  if (scrolling && now - lastScrollTime >= scrollInterval) {
    selectedRecord++;

    if (selectedRecord >= recordCount) {
      selectedRecord = 0;
    }

    lastScrollTime = now;
    updateScreens = true;
  }

  if (updateScreens) {
    showNames();
    showScore();
  }

  delay(20);
}
